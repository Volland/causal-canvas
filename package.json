{
  "name": "causal-canvas-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "CausalJSON format and toolchain",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "rm -rf spec/dist packages/*/dist",
    "typecheck": "tsc -b --noEmit false --dry 2>/dev/null || pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test \"spec/dist/**/*.test.js\" \"packages/*/dist/**/*.test.js\" && pnpm --filter causal-canvas run test",
    "conformance": "node packages/cli/dist/bin.js --version >/dev/null && node --test \"packages/core/dist/conformance.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/causal-canvas.git"
  }
}
