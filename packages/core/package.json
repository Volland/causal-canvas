{
  "name": "@vpavlyshyn/core",
  "version": "0.1.0",
  "description": "Parse, normalize, validate, and lint CausalJSON documents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ld": {
      "types": "./dist/ld.d.ts",
      "default": "./dist/ld.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/testutil.*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vpavlyshyn/spec": "workspace:*",
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "jsonld": "^8.3.3"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/causal-canvas.git",
    "directory": "packages/core"
  },
  "homepage": "https://volland.github.io/causal-canvas/",
  "bugs": {
    "url": "https://github.com/Volland/causal-canvas/issues"
  }
}
