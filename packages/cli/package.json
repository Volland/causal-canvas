{
  "name": "@vpavlyshyn/cli",
  "version": "0.1.0",
  "description": "Command line for CausalJSON: validate, lint, fmt, render, summarize",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "causal": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/testutil.*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vpavlyshyn/core": "workspace:*",
    "@vpavlyshyn/render": "workspace:*",
    "@vpavlyshyn/spec": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/causal-canvas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://volland.github.io/causal-canvas/",
  "bugs": {
    "url": "https://github.com/Volland/causal-canvas/issues"
  }
}
