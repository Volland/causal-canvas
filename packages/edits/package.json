{
  "name": "@causal-canvas/edits",
  "version": "0.1.0",
  "description": "Surgical text edits over CausalJSON documents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/testutil.*"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@causal-canvas/core": "workspace:*",
    "@causal-canvas/spec": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/causal-canvas.git",
    "directory": "packages/edits"
  },
  "homepage": "https://volland.github.io/causal-canvas/",
  "bugs": {
    "url": "https://github.com/Volland/causal-canvas/issues"
  }
}
